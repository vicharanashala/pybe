PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Scenario Generator (mentor-only feature)
# Set this to a secret only you know. It gates /api/scenario-gen/* routes.
MENTOR_ADMIN_TOKEN=change-me

# Scenario Generator — learner extension (Phase 2)
# Max case studies one learner (by email) can submit for review per rolling 24h.
LEARNER_SUBMISSION_CAP=3
