    "winston": "^3.19.0",
    "xss": "^1.0.15",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.9.0"
