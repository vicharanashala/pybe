# LLM API Keys (Provide any one or all of them for automatic failover)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Keys (Supports multiple keys for instant failover when TPM limit is hit!)
# Option 1: Comma-separated
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# Option 2: Separate numbered environment variables
GROQ_API_KEY=gsk_key1
GROQ_API_KEY_1=gsk_key1
GROQ_API_KEY_2=gsk_key2
GROQ_API_KEY_3=gsk_key3

# MiniMax API Key (https://platform.minimaxi.com)
MINIMAX_API_KEY=your_minimax_api_key_here

# Optional: Set preferred LLM provider ('gemini' | 'groq' | 'minimax' | 'auto')
PREFERRED_PROVIDER=auto

# Optional: Specific Model settings
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.1-8b-instant

# Use local compact specifications instead of root .docx.md to save token usage
USE_LOCAL_SPECS=true

# APP_URL
APP_URL="http://localhost:3000"
