PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Phase 3: AI provider configuration.
# Leave all of these unset to run in offline mode (deterministic, template-based
# responses - no API key or network access required, useful for local dev/demo).
#
# AI_PROVIDER selects which one to use explicitly: openai | anthropic | gemini | offline
# If unset, the first provider below with a configured API key is used automatically.
AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
