# pyBE Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED FOR PRODUCTION
# =============================================================================

# JWT signing secret - REQUIRED in production (min 32 characters recommended)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# =============================================================================
# STORAGE MODE (B4 MongoDB Migration)
# =============================================================================

# Storage mode: 'sqlite' (default) or 'mongodb'
# When set to 'mongodb', uses MongoDB instead of SQLite
# STORAGE_MODE=sqlite

# MongoDB connection URI (when STORAGE_MODE=mongodb)
# Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/pybe
#
# MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/pybe
#
# Required for MongoDB Atlas (no SRV):
# MONGODB_URI=mongodb://user:password@cluster-shard-0.mongodb.net:27017,cluster-shard-1.mongodb.net:27017/pybe?replicaSet=rs0&ssl=true
MONGODB_URI=mongodb://localhost:27017/pybe

# MongoDB database name (default: 'pybe')
# MONGODB_DB=pybe

# =============================================================================
# DATABASE (optional - defaults to SQLite)
# =============================================================================

# SQLAlchemy database URI (used when STORAGE_MODE=sqlite)
# Default: sqlite:///pybe.db
# For PostgreSQL: postgresql://user:password@localhost/pybe
# DATABASE_URL=sqlite:///pybe.db

# =============================================================================
# SERVER (optional)
# =============================================================================

# Port to run the server on (default: 5000)
# PYBE_PORT=5000

# Scenarios directory override (default: server/src/scenarios)
# PYBE_SCENARIOS_DIR=/path/to/scenarios

# CORS origins (default: * for development)
# Use comma-separated list for production, e.g., http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# Set to 'production' to enforce JWT_SECRET requirement
# FLASK_ENV=development

# =============================================================================
# AI EVALUATION (B1 Real AI Integration)
# =============================================================================

# Groq API key (recommended - fast, free tier available)
# Get your key at: https://console.groq.com/keys
# Groq uses OpenAI-compatible API with llama models
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Groq API base (do not change):
GROQ_API_BASE=https://api.groq.com/openai/v1

# OpenAI API key (alternative to Groq)
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_API_BASE=https://api.openai.com/v1

# Feature flag to enable/disable AI evaluation
# Set to 'false' to force mock evaluation mode
# Default: true (AI evaluation enabled when GROQ_API_KEY or OPENAI_API_KEY is set)
# USE_AI_EVALUATION=true