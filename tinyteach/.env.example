# TinyTeach — sample environment file.
# Copy to `.env` and edit. Do NOT commit `.env` to git.

# ---- Embedding ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ---- Chunking -------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Retrieval ------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.25

# ---- LLM ------------------------------------------------------------------
# Options: hf_inference | hf_local | groq | ollama
LLM_PROVIDER=hf_inference
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1800
# Generic token slot — used by hf_inference / groq if their specific
# token below is empty. Prefer setting the specific token.
LLM_API_TOKEN=

# Provider-specific credentials (preferred over LLM_API_TOKEN).
# HF_TOKEN: free tier works without it but is rate-limited.
HF_TOKEN=
# GROQ_API_TOKEN: required for the Groq provider. Get one free at groq.com.
GROQ_API_TOKEN=
OLLAMA_HOST=http://localhost:11434

# Free-tier retry behaviour (see PROJECT_BLUEPRINT §8.1).
LLM_REQUEST_TIMEOUT_S=60.0
LLM_MAX_RETRIES=3
LLM_RETRY_INITIAL_BACKOFF_S=2.0
LLM_RETRY_MAX_BACKOFF_S=60.0

# ---- Prompt ---------------------------------------------------------------
# Options: python | java | cpp | generic
PROMPT_LANGUAGE=python
PROMPT_VERSION=v1

# ---- App ------------------------------------------------------------------
APP_DATA_DIR=./data
APP_LOG_LEVEL=INFO
APP_LOG_RETENTION_DAYS=14

# ---- Generation guards ----------------------------------------------------
GEN_MAX_RETRIES=2
GEN_DETERMINISTIC=false